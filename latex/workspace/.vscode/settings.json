{
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.recipe.default": "make build",
  "latex-workshop.latex.recipes": [
    { "name": "make build", "tools": ["make-build"] }
  ],
  "latex-workshop.latex.tools": [
    { "name": "make-build", "command": "make", "args": ["build"], "env": {} }
  ],
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.search.rootFiles.include": ["tex/main.tex"],
  "latex-workshop.view.pdf.viewer": "tab",
  "files.exclude": { "build/": true }
}
