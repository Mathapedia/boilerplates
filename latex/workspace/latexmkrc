# latexmk configuration, read from the repository root (see Makefile).
#
# Mode: latex -> dvips -> ps2pdf. This is the only route on which PSTricks
# works; TikZ and \includegraphics{*.eps} work on it too. If a paper has no
# PSTricks it can switch to plain pdflatex with `make build MODE=-pdf`.
$pdf_mode = 4;          # 4 = -pdfps (dvi -> ps -> pdf)
$dvi_mode = 1;
$postscript_mode = 1;

$out_dir = '../build';  # relative to tex/ because we run with -cd
$aux_dir = '../build';

$latex = 'latex -interaction=nonstopmode -halt-on-error -file-line-error -synctex=1 %O %S';
$pdflatex = 'pdflatex -interaction=nonstopmode -halt-on-error -file-line-error -synctex=1 %O %S';
$dvips = 'dvips %O -o %D %S';
$ps2pdf = 'ps2pdf -dALLOWPSTRANSPARENCY %O %S %D';

$bibtex_use = 2;        # run bibtex when needed; delete .bbl on clean
$max_repeat = 5;

# Let \includegraphics find EPS generated by `make figures`, and let bibtex
# find references.bib from the aux dir.
$ENV{'TEXINPUTS'} = '.:../build/figures//:' . ($ENV{'TEXINPUTS'} // '');
$ENV{'BIBINPUTS'} = '.:' . ($ENV{'BIBINPUTS'} // '');

# Extra generated extensions to remove on `latexmk -C`.
$clean_ext = 'synctex.gz run.xml bbl nav snm vrb';

# -pvc: when a source changes, rebuild; do not try to launch a viewer inside
# the container. `make watch` wraps this.
$preview_continuous_mode = 0;
$pdf_previewer = 'true';
$sleep_time = 1;
